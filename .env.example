# מפתח Gemini. זה המסלול המועדף והזול.
# ברירת המחדל היא gemini-3.5-flash-lite (פלאש זול ועדכני).
# gemini-2.0-flash כבר לא פעיל. אפשר להחליף דגם כאן.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# חלופה: מפתח תואם OpenAI, לדגם מיני.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 0 מכבה בדיקת תמונות של חדר או תיק, גם אם יש מפתח.
LLM_VISION=1
